{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build telemetry for deployment",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-NonInteractive",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Build-Deploy.ps1",
                "-BuildOnly"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Build and deploy telemetry",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-NonInteractive",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Build-Deploy.ps1"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}