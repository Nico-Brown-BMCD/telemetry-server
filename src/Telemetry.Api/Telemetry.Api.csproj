<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning.ApiExplorer"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
        <PackageReference Include="MongoDB.EntityFrameworkCore"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <PackageReference Include="Oracle.EntityFrameworkCore"/>
        <PackageReference Include="prometheus-net.AspNetCore"/>
        <PackageReference Include="Serilog.AspNetCore"/>
        <PackageReference Include="Serilog.Sinks.Console"/>
        <PackageReference Include="Swashbuckle.AspNetCore"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Link="README.md"/>
        <None Include="../../*.md" LinkBase="assets/docs/" Exclude="../../README.md"/>
    </ItemGroup>
    
    <ItemGroup>
        <None Include="../../*.props" LinkBase="assets/"/>
        <None Include="../../*.targets" LinkBase="assets/"/>
        <None Include="../../.github/workflows/*.yml" LinkBase="assets/ci/"/>
    </ItemGroup>
    
    <ItemGroup>
        <None Include="../../*.yml" LinkBase="assets/compose/"/>
    </ItemGroup>

    <!--
        Migration assemblies cannot be ProjectReferenced (they reference this project), so Program.cs
        side-loads them by file name at startup. Publish must therefore copy them in by hand, or
        Database.MigrateAsync finds no migrations assembly. Set MigrationsProvider=none to opt out.
    -->
    <PropertyGroup>
        <MigrationsProvider Condition="'$(MigrationsProvider)' == ''">SqlServer</MigrationsProvider>
    </PropertyGroup>

    <Target Name="PublishMigrationsAssembly" AfterTargets="Publish" Condition="'$(MigrationsProvider)' != 'none'">
        <PropertyGroup>
            <_MigrationsProject>$(MSBuildThisFileDirectory)../Telemetry.Migrations.$(MigrationsProvider)/Telemetry.Migrations.$(MigrationsProvider).csproj</_MigrationsProject>
            <_MigrationsBinDir>$(MSBuildThisFileDirectory)bin/$(Configuration)/$(TargetFramework)/</_MigrationsBinDir>
        </PropertyGroup>

        <Error Condition="!Exists('$(_MigrationsProject)')"
               Text="MigrationsProvider '$(MigrationsProvider)' does not match a Telemetry.Migrations.* project."/>

        <!-- BuildProjectReferences=false stops this project being rebuilt re-entrantly mid-publish. -->
        <MSBuild Projects="$(_MigrationsProject)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);BuildProjectReferences=false"/>

        <ItemGroup>
            <_MigrationsOutput Include="$(_MigrationsBinDir)Telemetry.Migrations.$(MigrationsProvider).dll"/>
            <_MigrationsOutput Include="$(_MigrationsBinDir)Telemetry.Migrations.$(MigrationsProvider).pdb"/>
        </ItemGroup>

        <Copy SourceFiles="@(_MigrationsOutput)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"/>

        <Error Condition="!Exists('$(PublishDir)Telemetry.Migrations.$(MigrationsProvider).dll')"
               Text="Telemetry.Migrations.$(MigrationsProvider).dll was not published; migrations would silently not apply."/>

        <Message Importance="high" Text="Published migrations assembly Telemetry.Migrations.$(MigrationsProvider).dll"/>
    </Target>

</Project>
